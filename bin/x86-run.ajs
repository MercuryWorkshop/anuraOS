#! {"lang":"module"}

export async function main(args) {
    let cmd = args;

    if (!cmd || !cmd.length) {
        cmd = ["/bin/bash", "--login"];
    }

    const pty = await anura.gex.sys.spawn(
        cmd,
        {
            pty: { rows: 80, cols: 24 },
            env: {
                "TERM": "xterm-256color",
                ...anura.gex.windows.env
            }
        },
    );
    pty.pty.addEventListener("data", (ev)=>{
        print(ev.data);
    });

    addEventListener("message", (event) => {
        if (event.data.type === "ioctl.set") {
            pty.pty.resize(event.data.windowSize.cols, event.data.windowSize.rows);
        }
    });

    addEventListener("message", (event) => {
        if (event.data.type === "stdin") {
            pty.pty.write(event.data.message);
        }
    });

    const oldkill = env.process.kill.bind(env.process);

    env.process.kill = (signal) => {
        pty.kill();
        oldkill(signal);
    };
}
